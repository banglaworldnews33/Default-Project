# Copy this file to `.env` and fill in real values. Never commit real secrets.
# Frontend environment variables must be prefixed with VITE_ .

# ---- Supabase (required for auth, DB, storage) ----
# Get these from your Supabase project dashboard: https://supabase.com
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key-here>

# ---- Google Sheets integration (optional) ----
# Endpoint of your Google Apps Script Web App or Sheets API proxy that appends orders.
# Leave empty to use the local storage fallback.
VITE_GOOGLE_SHEETS_WEBAPP_URL=

# A shared secret your Apps Script expects, e.g. a simple token string.
# Never place a real Google service-account key here.
VITE_GOOGLE_SHEETS_TOKEN=

# ---- Backend API (future) ----
# Will point to your custom Node.js/Express or other backend when ready.
VITE_API_BASE_URL=

# ---- Cloudinary (public configuration only) ----
# Only the cloud name is public and safe in the browser bundle.
# Find it in your Cloudinary dashboard (https://cloudinary.com/console).
VITE_CLOUDINARY_CLOUD_NAME=

# ---- Edge Function secrets (SERVER-ONLY — never VITE_, never committed) ----
# Set these with `supabase secrets set NAME=value` (per environment).
# They live in the Supabase function vault ONLY. Never paste values here.
# Required by supabase/functions/cloudinary-sign and cloudinary-delete:
#   CLOUDINARY_API_KEY        (Cloudinary dashboard, publishable identifier)
#   CLOUDINARY_API_SECRET     (Cloudinary dashboard, SECRET — server only)
#   SUPABASE_URL              (same project URL as VITE_SUPABASE_URL)
#   SUPABASE_SERVICE_ROLE_KEY (Supabase dashboard API settings, SECRET — server only)
# Frontend code must never reference CLOUDINARY_API_SECRET or service_role.